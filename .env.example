# ---------------------------------------------------------------------------
# Public site configuration (no secrets). Copy to .env and adjust per deploy.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# they must be set before running `next build`. All values are optional and
# fall back to the placeholders in lib/site.ts.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (used for canonical URLs, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Business name (shown in header/footer/structured data).
NEXT_PUBLIC_BUSINESS_NAME=Abid Ali Tailors

# WhatsApp number in E.164 format (used for wa.me chat links).
NEXT_PUBLIC_BUSINESS_WHATSAPP=+923001234567

# Phone number (E.164) and its display format (shown to visitors).
NEXT_PUBLIC_BUSINESS_PHONE=+923001234567
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=0300-1234567

# Public contact email.
NEXT_PUBLIC_BUSINESS_EMAIL=hello@example.com

# Shop address shown in the footer and location section.
NEXT_PUBLIC_BUSINESS_ADDRESS=Shop #12, Main Street, Karachi, Pakistan

# Google Maps link and embed source for the location section.
NEXT_PUBLIC_BUSINESS_MAP_LINK=https://www.google.com/maps/search/?api=1&query=Karachi
NEXT_PUBLIC_BUSINESS_MAP_EMBED=https://www.google.com/maps?q=Karachi&output=embed

# Social profile URLs.
NEXT_PUBLIC_BUSINESS_FACEBOOK=https://facebook.com/
NEXT_PUBLIC_BUSINESS_INSTAGRAM=https://instagram.com/
NEXT_PUBLIC_BUSINESS_TIKTOK=https://tiktok.com/

# ---------------------------------------------------------------------------
# Email delivery (contact / booking / call-scheduling forms).
# Forms send a nicely formatted email to the recipient below. If SMTP is not
# configured the request is still accepted and logged (never fails silently
# from the user's perspective).
# ---------------------------------------------------------------------------

# Mailbox that receives all form submissions.
CONTACT_TO=orders@your-domain.example.com

# SMTP credentials for the sending account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# From address shown on outgoing emails.
SMTP_FROM=noreply@your-domain.example.com

# ---------------------------------------------------------------------------
# Security / spam protection
# ---------------------------------------------------------------------------

# Optional external honeypot-style spam gate. Leave empty to rely on the
# built-in honeypot field + minimum-fill-time checks.
SPAM_GATE_URL=

# ---------------------------------------------------------------------------
# Analytics (optional). Any event URL collector; events are POSTed as JSON.
# Leave empty to disable tracking.
# ---------------------------------------------------------------------------
ANALYTICS_ENDPOINT=
